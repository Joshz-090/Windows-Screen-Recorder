<Window x:Class="ScreenRecorder.App.TeachingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teaching Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <DropShadowEffect x:Key="ToolbarShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="#000000"/>

        <Style x:Key="ToolBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button" BasedOn="{StaticResource ToolBtnStyle}">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="BorderBrush" Value="#52525B"/>
        </Style>

        <Style x:Key="DoneBtnStyle" TargetType="Button" BasedOn="{StaticResource ToolBtnStyle}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </Window.Resources>

    <Border Background="#F218181B" CornerRadius="12" BorderBrush="#3F3F46" BorderThickness="1"
            Padding="10,6" Margin="10" Effect="{StaticResource ToolbarShadow}"
            MouseLeftButtonDown="OnDragToolbar">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Drag Handle & Title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,12,0" Cursor="SizeAll">
                <TextBlock Text="⋮⋮" Foreground="#71717A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Teaching Mode" Foreground="#A1A1AA" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
            </StackPanel>

            <!-- Tool buttons -->
            <Button x:Name="BtnPointer" Content="Cursor" Click="OnSelectTool_Pointer" Style="{StaticResource ToolBtnStyle}" ToolTip="Interact with desktop apps (pass-through)"/>
            <Button x:Name="BtnArrow" Content="Arrow" Click="OnSelectTool_Arrow" Style="{StaticResource ToolBtnStyle}" ToolTip="Draw arrow annotations"/>
            <Button x:Name="BtnRect" Content="Rectangle" Click="OnSelectTool_Rect" Style="{StaticResource ToolBtnStyle}" ToolTip="Draw rectangle annotations"/>
            <Button x:Name="BtnUnderline" Content="Underline" Click="OnSelectTool_Underline" Style="{StaticResource ToolBtnStyle}" ToolTip="Draw underline annotations"/>
            <Button x:Name="BtnPen" Content="Pen" Click="OnSelectTool_Pen" Style="{StaticResource ToolBtnStyle}" ToolTip="Draw freehand pen strokes"/>

            <Separator Width="1" Height="20" Background="#3F3F46" Margin="8,0"/>

            <!-- Color buttons -->
            <Button x:Name="BtnColorRed" Click="OnSelectColor_Red" Background="#EF4444" Style="{StaticResource ColorBtnStyle}" ToolTip="Red"/>
            <Button x:Name="BtnColorYellow" Click="OnSelectColor_Yellow" Background="#EAB308" Style="{StaticResource ColorBtnStyle}" ToolTip="Yellow"/>
            <Button x:Name="BtnColorGreen" Click="OnSelectColor_Green" Background="#22C55E" Style="{StaticResource ColorBtnStyle}" ToolTip="Green"/>
            <Button x:Name="BtnColorBlue" Click="OnSelectColor_Blue" Background="#3B82F6" Style="{StaticResource ColorBtnStyle}" ToolTip="Blue"/>

            <Separator Width="1" Height="20" Background="#3F3F46" Margin="8,0"/>

            <!-- Action buttons -->
            <Button Content="Undo" Click="OnUndo" Style="{StaticResource ActionBtnStyle}" ToolTip="Undo last annotation"/>
            <Button Content="Clear" Click="OnClear" Style="{StaticResource ActionBtnStyle}" ToolTip="Clear all annotations"/>
            <Button Content="Done" Click="OnDone" Style="{StaticResource DoneBtnStyle}" ToolTip="Finish teaching mode"/>
        </StackPanel>
    </Border>
</Window>
