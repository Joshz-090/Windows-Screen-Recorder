<Window x:Class="ScreenRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Screen Recorder - Professional Studio"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12">

    <Window.Resources>
        <!-- Modern Dark Theme Styles -->
        <SolidColorBrush x:Key="BgDark" Color="#0F0F12"/>
        <SolidColorBrush x:Key="CardDark" Color="#18181B"/>
        <SolidColorBrush x:Key="BorderDark" Color="#27272A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="AccentColor" Color="#6366F1"/>
        <SolidColorBrush x:Key="RecordRed" Color="#EF4444"/>

        <!-- ComboBox dark theme overrides (fixes white-on-white dropdown) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="▾" Foreground="#A1A1AA" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,24,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F4F4F5"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <Border x:Name="DropDownBorder" Background="#1C1C1F" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer CanContentScroll="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardDark}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Controls & Configuration Area -->
            <ColumnDefinition Width="420"/>
            <!-- Right Library & Preview Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Studio Recording Controls -->
        <Border Grid.Column="0" Background="#141417" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Top Logo / Title Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentColor}" Margin="0,0,12,0">
                            <TextBlock Text="REC" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Screen Recorder Studio" Style="{StaticResource HeaderTitle}"/>
                            <TextBlock Text="Professional Teaching &amp; Capture" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Recording Status Panel -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#71717A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStatus" Text="Ready to Record" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTimer" Text="00:00:00" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" FontFamily="Consolas"/>
                            </Grid>

                            <!-- Primary Action Buttons -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnRecordToggle" Grid.Column="0" Content="Start Recording" Click="OnToggleRecord" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0"/>
                                <Button x:Name="BtnPause" Grid.Column="1" Content="Pause" Click="OnPauseResume" Background="#27272A" Foreground="#FFFFFF" FontWeight="Medium" Padding="14,10" BorderThickness="0" Margin="0,0,8,0" IsEnabled="False" Cursor="Hand"/>
                                <Button x:Name="BtnTeaching" Grid.Column="2" Content="Teaching" Click="OnToggleTeaching" Background="#27272A" Foreground="#A5B4FC" FontWeight="SemiBold" Padding="14,10" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <!-- Live Audio Meters (Mic & System) -->
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Microphone Level" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    <TextBlock x:Name="TxtMicLevel" Text="0%" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PbMicLevel" Height="6" Minimum="0" Maximum="100" Value="0" Background="#27272A" Foreground="#22C55E" BorderThickness="0" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="System Audio Loopback" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    <TextBlock x:Name="TxtSysLevel" Text="0%" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PbSysLevel" Height="6" Minimum="0" Maximum="100" Value="0" Background="#27272A" Foreground="#3B82F6" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Interactive Saving & Conversion Progress Panel (Counts 1 to 100%) -->
                    <Border x:Name="SavingProgressPanel" Style="{StaticResource CardBorder}" Margin="0,0,0,20" Visibility="Collapsed" BorderBrush="#6366F1" BorderThickness="1.5">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#6366F1" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtSavingTitle" Text="Saving &amp; Encoding Video" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSavingPercentage" Text="0%" Foreground="#818CF8" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" FontFamily="Consolas"/>
                            </Grid>

                            <!-- Modern Progress Bar with 1 to 100 counter -->
                            <ProgressBar x:Name="PbSavingProgress" Height="8" Minimum="0" Maximum="100" Value="0" Background="#27272A" Foreground="#6366F1" BorderThickness="0" Margin="0,0,0,8"/>

                            <!-- Real-time Step Description (WAV -> MP4 conversion feedback) -->
                            <TextBlock x:Name="TxtSavingDetail" Text="Initializing conversion pipeline..." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <!-- Finished State Details & Actions -->
                            <StackPanel x:Name="PanelSavingFinished" Visibility="Collapsed" Margin="0,6,0,0">
                                <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="✓ Finished! Video Saved Successfully" Foreground="#34D399" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock x:Name="TxtFinishedFileInfo" Text="recording.mp4" Foreground="#A7F3D0" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="▶ Play Video" Click="OnPlayLastVideo" Background="#3F3F46" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="10,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                    <Button Grid.Column="1" Content="📁 Open Folder" Click="OnOpenFolder" Background="#27272A" Foreground="#D4D4D8" FontWeight="Medium" Padding="10,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                    <Button Grid.Column="2" Content="Dismiss" Click="OnDismissSavingPanel" Background="#18181B" Foreground="#71717A" Padding="8,6" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>

                            <!-- Error State Panel -->
                            <StackPanel x:Name="PanelSavingError" Visibility="Collapsed" Margin="0,6,0,0">
                                <Border Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtSavingErrorDetail" Text="An error occurred while saving." Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                                <Button Content="Dismiss" Click="OnDismissSavingPanel" Background="#27272A" Foreground="#FFFFFF" Padding="8,4" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Capture Settings -->
                    <TextBlock Text="CAPTURE CONFIGURATION" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Screen Source -->
                            <TextBlock Text="Display Source" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CbSources" Background="#27272A" Foreground="#FFFFFF" Height="32" Margin="0,0,0,12" SelectedIndex="0"/>

                            <!-- Resolution & Framerate -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Resolution" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CbResolution" Background="#27272A" Foreground="#FFFFFF" Height="32" SelectedIndex="0">
                                        <ComboBoxItem Content="1920x1080 (1080p)"/>
                                        <ComboBoxItem Content="1280x720 (720p)"/>
                                        <ComboBoxItem Content="Native Display"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Frame Rate" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CbFps" Background="#27272A" Foreground="#FFFFFF" Height="32" SelectedIndex="0">
                                        <ComboBoxItem Content="30 FPS (Standard)"/>
                                        <ComboBoxItem Content="60 FPS (High Motion)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Encoder Selection -->
                            <TextBlock Text="Video Codec / Encoder" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CbEncoder" Background="#27272A" Foreground="#FFFFFF" Height="32" SelectedIndex="0">
                                <ComboBoxItem Content="h264_qsv (Intel Quick Sync Hardware)"/>
                                <ComboBoxItem Content="libx264 (Software Fallback)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Audio Sources -->
                    <TextBlock Text="AUDIO SOURCES" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Microphone" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CbMicrophones" Background="#27272A" Foreground="#FFFFFF" Height="32" Margin="0,0,0,12" SelectedIndex="0"/>

                            <CheckBox x:Name="ChkSystemAudio" Content="Record System Audio (WASAPI Loopback)" Foreground="{StaticResource TextPrimary}" IsChecked="True" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostics & System Stats -->
                    <TextBlock Text="SYSTEM DIAGNOSTICS" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Actual Recorded FPS" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock x:Name="TxtActualFps" Text="0.0" Foreground="#22C55E" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Encoded Frames" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock x:Name="TxtEncodedFrames" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Dropped Frames" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock x:Name="TxtDroppedFrames" Text="0" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Column: Recording Library & File Manager -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Library Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Recording Library" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Manage, inspect, and play your tutorial captures" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Open Output Folder" Click="OnOpenFolder" Background="#27272A" Foreground="#FFFFFF" FontWeight="Medium" Padding="12,8" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Refresh" Click="OnRefreshLibrary" Background="#27272A" Foreground="#FFFFFF" FontWeight="Medium" Padding="12,8" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Recording Items List & Empty State -->
            <Border Grid.Row="1" Background="{StaticResource CardDark}" CornerRadius="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <Grid>
                    <!-- Empty Library State -->
                    <Border x:Name="BorderEmptyLibrary" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28" Background="#27272A" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🎬" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No Recordings Yet" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Click 'Start Recording' on the left to capture your first video." Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="280"/>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="LvRecordings" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Video Icon / Thumbnail Indicator -->
                                        <Border Grid.Column="0" Width="44" Height="44" Background="#27272A" CornerRadius="8" Margin="0,0,14,0">
                                            <TextBlock Text="MP4" Foreground="#818CF8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Resolution}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding FileSizeFormatted}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Play" Click="OnPlayItem" Tag="{Binding FilePath}" Background="#3F3F46" Foreground="#FFFFFF" FontWeight="Medium" Padding="12,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="Show in Folder" Click="OnShowItemInFolder" Tag="{Binding FilePath}" Background="#27272A" Foreground="#D4D4D8" FontWeight="Medium" Padding="10,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="Delete" Click="OnDeleteItem" Tag="{Binding FilePath}" Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="Medium" Padding="10,6" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
